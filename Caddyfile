https://localhost, https://caddy {
  tls internal
  encode zstd gzip

  handle_path /media/* {
    root * /srv/media
    file_server
  }

  reverse_proxy /api/* web-http:8000

  reverse_proxy /ws/* web-ws:8001 {
    transport http {
      versions 1.1
    }
    stream_timeout 24h
    stream_close_delay 30s
  }

  reverse_proxy /* web-http:8000
}
