https://localhost {
  tls internal
  encode zstd gzip

  # Media
  handle_path /media/* {
    root * /srv/media
    file_server
  }

  # REST API (Gunicorn/Uvicorn)
  reverse_proxy /api/* web-http:8000 {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
  }

  # WebSockety (Chat)
  reverse_proxy /ws/* web-ws:8001 {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    transport http {
      versions 1.1
    }
  }

  # SPA / frontend
  reverse_proxy /* web-http:8000
}
