# Ten plik jest przykładem. Skopiuj go do .env.docker i uzupełnij wartości.
# Uwaga: nie commituj .env.docker do repo (sekrety).

# Ścieżka do pliku env czytanego przez Django-environ w kontenerze.
ENV_FILE=/app/.env.docker

# Nazwa aplikacji
SITE_NAME=MyCent

# Bazowy URL aplikacji (musi odpowiadać temu, pod czym wchodzisz w przeglądarce).
# DEV: https://localhost (Caddy z tls internal)
# LAN:  https://192.168.1.10 (IP hosta w LAN)
SITE_URL=https://localhost

# Tryb debug Django:
# - True: DEV (więcej logów, mniej restrykcji)
# - False: "produkcyjnie"
DJANGO_DEBUG=False

# Wymagane: klucz bezpieczeństwa Django.
# Wygeneruj losowy, długi string (min. ~50 znaków).
DJANGO_SECRET_KEY=change-this-in-prod-super-long-random

# Dozwolone hosty dla Django (Host header). Musi zawierać hosta z SITE_URL.
# DEV: localhost,127.0.0.1
# LAN: dopisz IP hosta, np. 192.168.1.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,web-http,caddy

# WhiteNoise manifest dla statyków (zostaw True).
USE_MANIFEST=True

# CORS/CSRF/WS origins:
# Jeśli używasz frontendu (np. Vite) na osobnym porcie, dopisz https://localhost:5173.
# Jeśli aplikacja ma być dostępna z LAN, dopisz origin(y) z IP hosta.
# Przykład LAN:
# CORS_ALLOWED_ORIGINS=https://localhost,https://192.168.1.10,https://localhost:5173,https://192.168.1.10:5173
CORS_ALLOWED_ORIGINS=https://localhost,https://localhost:5173
# Przykład LAN:
# CSRF_TRUSTED_ORIGINS=https://localhost,https://192.168.1.10
CSRF_TRUSTED_ORIGINS=https://localhost
# WebSockety (chat) – analogicznie jak CORS:
WS_ALLOWED_ORIGINS=https://localhost,https://localhost:5173

# Bezpieczeństwo cookies/SSL:
# Jeśli używasz Caddy + https (jak w Twoim compose) zostaw True.
# Jeśli uruchamiasz bez TLS (rzadko w tym projekcie) ustaw False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Redirect HTTP -> HTTPS:
# DEV z Caddy: może zostać True
# Testy/perf bez TLS: ustaw False (jak w compose.test.yml)
SECURE_SSL_REDIRECT=True

# HSTS:
# DEV: zwykle 0
# PROD: np. 31536000 (1 rok)
SECURE_HSTS_SECONDS=0

# Postgres:
# W tym compose hostem jest nazwa serwisu: db
POSTGRES_DB=lown
POSTGRES_USER=lown
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Najwygodniej trzymać DATABASE_URL (Django umie ją parsować).
DATABASE_URL=postgresql://lown:change-me@db:5432/lown
DB_CONN_MAX_AGE=60

# Redis + Celery:
# Redis jest serwisem "redis" w compose, port standardowy 6379.
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# Email:
# DEV: MailPit działa w compose jako host "mailpit" i port 1025 (SMTP), UI na http://localhost:8025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@lown.local

# Konto administratora:
# Dane używane przez komendę seed_admin przy starcie (tworzy/aktualizuje admina).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
# Jeśli w Twoim modelu użytkownika istnieje pole "role" i obsługuje OWNER, zostaw OWNER.
ADMIN_ROLE=OWNER

# Auth cookies (refresh token w cookie):
# Zwykle zostaw domyślne.
JWT_REFRESH_IN_COOKIE=True
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/auth/
AUTH_COOKIE_HTTPONLY=True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Strict

# Zostaw puste jeśli używasz localhost albo IP.
# Ustaw tylko gdy używasz domeny i chcesz, żeby cookie działało na subdomenach:
# AUTH_COOKIE_DOMAIN=.lown.local
AUTH_COOKIE_DOMAIN=

# Stripe (TEST):
# Jeśli nie testujesz Stripe, możesz zostawić puste (aplikacja ma symulowanego operatora).
# STRIPE_PUBLISHABLE_KEY i STRIPE_SECRET_KEY bierz z Dashboard Stripe (tryb testowy).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# STRIPE_API_KEY jest używany przez kontener stripe-cli (może być identyczny jak STRIPE_SECRET_KEY).
STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET bierzesz z outputu stripe-cli po uruchomieniu "stripe listen"
# (linia w stylu: whsec_...).
STRIPE_WEBHOOK_SECRET=

# Cache TTL (sekundy) – zostaw domyślne, ewentualnie zwiększ jeśli chcesz mniej odpytywań.
PUBLIC_ITEMSETS_LIST_CACHE_TTL=20
PUBLIC_ITEMSETS_DETAIL_CACHE_TTL=15

# Gunicorn workers:
# Jeśli puste, compose ustawi domyślnie 3. Możesz podnieść np. do 4 na mocniejszym hoście.
WEB_CONCURRENCY=3
