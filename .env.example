# Ten plik jest przykładem. Skopiuj go do .env.docker i uzupełnij wartości.
# Uwaga: nie commituj .env.docker do repo (sekrety).

# Ścieżka do pliku env czytanego przez Django-environ w kontenerze.
ENV_FILE=/app/.env.docker

# Nazwa aplikacji
SITE_NAME=MyCent

# Bazowy URL aplikacji.
SITE_URL=https://localhost

# Tryb debug Django:
DJANGO_DEBUG=False

# Wymagane: klucz bezpieczeństwa Django.
DJANGO_SECRET_KEY=change-this-in-prod-super-long-random

# Dozwolone hosty dla Django (Host header). Musi zawierać hosta z SITE_URL.
DJANGO_ALLOWED_HOSTS=localhost,web,web-http,caddy,0.0.0.0

# WhiteNoise manifest dla statyków (zostaw True).
USE_MANIFEST=True

# CORS/CSRF/WS origins:
CORS_ALLOWED_ORIGINS=https://localhost,https://localhost:5173
CSRF_TRUSTED_ORIGINS=https://localhost,https://localhost:5173
WS_ALLOWED_ORIGINS=https://localhost,https://localhost:5173

# Bezpieczeństwo cookies/SSL:
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Redirect HTTP -> HTTPS:
SECURE_SSL_REDIRECT=True

# HSTS:
# DEV: zwykle 0
# PROD: np. 31536000 (1 rok)
SECURE_HSTS_SECONDS=0

# Postgres:
POSTGRES_DB=lown
POSTGRES_USER=lown
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL
DATABASE_URL=postgresql://lown:change-me@db:5432/lown

DB_CONN_MAX_AGE=60

# Redis + Celery:
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# ===== JWT / Cookies =====

# Czy odświeżanie refresh tokena ma weryfikować IP.
REFRESH_ENFORCE_IP=False
# UA:
REFRESH_ENFORCE_UA=True

# Czy dopuszczać Bearer w Authorization header
JWT_ALLOW_AUTH_HEADER_BEARER=False

# Czy access token ma być trzymany w cookie
JWT_ACCESS_IN_COOKIE=True
ACCESS_COOKIE_NAME=access_token
ACCESS_COOKIE_PATH=/api/
ACCESS_COOKIE_HTTPONLY=True
ACCESS_COOKIE_SECURE=True
ACCESS_COOKIE_SAMESITE=Strict
ACCESS_COOKIE_DOMAIN=

# Czy refresh token ma być trzymany w cookie
JWT_REFRESH_IN_COOKIE=True
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/auth/
AUTH_COOKIE_HTTPONLY=True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Strict
AUTH_COOKIE_DOMAIN=

# Pozostałe SameSite cookies
SESSION_COOKIE_SAMESITE=Strict
CSRF_COOKIE_SAMESITE=Strict

# ===== Email (DEV: MailPit) =====
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@lown.local

# Konto administratora (seed_admin):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_ROLE=OWNER

# ===== STRIPE (TEST) =====
# Jeśli nie używasz Stripe, zostaw puste.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Używane też przez stripe-cli (może być identyczne jak STRIPE_SECRET_KEY).
STRIPE_API_KEY=
# stripe-cli wypisze np. "Ready! Your webhook signing secret is whsec_*****"
STRIPE_WEBHOOK_SECRET=

# ===== WebSocket reference tokens (chat) =====
WS_REFERENCE_TOKEN_TTL=30
WS_REFERENCE_TOKEN_MAX_USES=1
WS_REFERENCE_TOKEN_SINGLE_USE=True
WS_REFERENCE_TOKEN_ENFORCE_IP=False
WS_REFERENCE_TOKEN_ENFORCE_UA=True

# ===== Cache TTL (sekundy) =====
PUBLIC_ITEMSETS_LIST_CACHE_TTL=20
PUBLIC_ITEMSETS_DETAIL_CACHE_TTL=15

# ===== Gunicorn workers =====
WEB_CONCURRENCY=4

# ===== Opcjonalne (defaulty w settings.py) =====
# DRF_NUM_PROXIES=1
# DRF_THROTTLE_ANON=120/min
# DRF_THROTTLE_USER=600/min
# DRF_THROTTLE_LOGIN=12/min
# DRF_THROTTLE_REFRESH=60/min
# DRF_THROTTLE_REGISTER=6/min
# DRF_THROTTLE_FORGOT_PASSWORD=6/min
# DRF_THROTTLE_RESET_PASSWORD=10/min
# DRF_THROTTLE_WS_TOKEN=60/min

# Webhook na nowe wiadomości czatu:
CHAT_NEW_MESSAGE_WEBHOOK_URL=
CHAT_NEW_MESSAGE_WEBHOOK_SECRET=
